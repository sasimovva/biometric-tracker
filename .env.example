# ====================================================================
# Telegram Chatbot Configurations
# ====================================================================
# Note: TELEGRAM_BOT_TOKEN and ANTHROPIC_API_KEY are normally provided by the
# shared sops-encrypted secrets in ~/Code/secrets.enc.json (see secrets_loader.py).
# Anything set here in .env overrides those shared values.

# Obtain this token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Restrict the bot to only accept inputs from your user ID
# Send a message to @userinfobot on Telegram to find your User ID
ALLOWED_USER_ID=your_numerical_telegram_user_id

# ====================================================================
# LLM Configuration (Anthropic / Claude)
# ====================================================================
# llm_parser.py uses the Anthropic SDK with ANTHROPIC_API_KEY (from shared secrets).
# Default model is Claude Haiku 4.5. Override the model below if desired.
# LLM_MODEL=claude-haiku-4-5
