# ====================================================================
# Telegram Chatbot Configurations
# ====================================================================

# Obtain this token from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Restrict the bot to only accept inputs from your user ID
# Send a message to @userinfobot on Telegram to find your User ID
ALLOWED_USER_ID=your_numerical_telegram_user_id

# ====================================================================
# LLM Endpoint Configurations (Swappable)
# ====================================================================

# For Local Mac Mini LLM (e.g., Ollama):
LLM_API_BASE=http://localhost:11434/v1
LLM_MODEL=llama3
LLM_API_KEY=unused

# For Public OpenAI API (uncomment if using instead of local):
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# LLM_API_KEY=your_openai_api_key_here

# For Public Gemini API (uncomment if using instead of local):
# LLM_API_BASE=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-1.5-flash
# LLM_API_KEY=your_gemini_api_key_here
